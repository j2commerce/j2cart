<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="user" method="upgrade">
	<name>User - Register for J2 Store</name>
	<author>J2Commerce</author>
	<creationDate>APR 2026</creationDate>
	<copyright>(C) 2014-2024 J2Store Weblogicx India</copyright>
	<copyright>(C) 2024-2026 J2Commerce, LLC</copyright>
	<license>GNU General Public License v3 or later versions</license>
	<authorEmail>support@j2commerce.com</authorEmail>
	<authorUrl>https://www.j2commerce.com</authorUrl>
	<version>4.0.0</version>
	<description>J2Store Profile on Joomla user registration</description>

	<files>
		<filename plugin="j2userregister">j2userregister.php</filename>
		<folder>fields</folder>
		<folder>js</folder>
		<folder>tmpl</folder>
	</files>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="show_address_fields"
					type="radio"
					default="1"
					class="btn-group"
					label="J2STORE_J2USERREGISTER_SHOW_ADDRESS_FIELDS"
					description="J2STORE_J2USERREGISTER_SHOW_ADDRESS_FIELDS_DESC"
					>
					<option value="0">J2STORE_HIDE</option>
					<option value="1">J2STORE_SHOW</option>
				</field>
				<field
					name="field_html"
					type="textarea"
					filter="safehtml"
					label="J2STORE_J2USERREGISTER_FIELDS_HTML"
				/>
				<field
					name="show_myprofile"
					type="radio"
					default="0"
					class="btn-group"
					label="J2STORE_J2USERREGISTER_SHOW_MYPROFILE"
					description="J2STORE_J2USERREGISTER_SHOW_MYPROFILE_DESC"
					>
					<option value="0">J2STORE_HIDE</option>
					<option value="1">J2STORE_SHOW</option>
				</field>
				<field
					name="disable_name"
					type="radio"
					default="0"
					class="btn-group"
					label="J2STORE_J2USERREGISTER_DISABLE_FIRST_AND_LAST_NAME"
					description="J2STORE_J2USERREGISTER_DISABLE_FIRST_AND_LAST_NAME_DESC"
					>
					<option value="0">J2STORE_HIDE</option>
					<option value="1">J2STORE_SHOW</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
