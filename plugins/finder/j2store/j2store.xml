<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="finder" method="upgrade">
    <name>Smart Search - J2 Store</name>
    <version>4.1.0</version>
    <creationDate>JAN 2026</creationDate>
    <author>J2Commerce</author>
    <authorEmail>support@j2commerce.com</authorEmail>
    <authorUrl>https://www.j2commerce.com</authorUrl>
    <copyright>(C) 2014-2024 J2Store Weblogicx India</copyright>
    <copyright>(C) 2024-2026 J2Commerce, LLC</copyright>
    <license>GNU General Public License v3 or later versions</license>
    <description>PLG_FINDER_J2STORE_DESCRIPTION</description>
    <namespace path="src">Joomla\Plugin\Finder\J2Store</namespace>
    <files>
        <folder plugin="j2store">services</folder>
        <folder>src</folder>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/plg_finder_j2store.ini</language>
        <language tag="en-GB">language/en-GB/plg_finder_j2store.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic" addfieldprefix="Joomla\Plugin\Finder\J2Store\Field">
                <field
                    name="redirect_to"
                    type="list"
                    label="PLG_FINDER_J2STORE_REDIRECT_TO_LABEL"
                    description="PLG_FINDER_J2STORE_REDIRECT_TO_LABEL_DESC"
                    default="j2store"
                    required="true"
                    >
                    <option value="j2store">PLG_FINDER_J2STORE_VIEW</option>
                    <option value="article">PLG_FINDER_J2STORE_ARTICLE_VIEW</option>
                </field>

                <field
                    name="menuitem_id"
                    type="j2storemenuitem"
                    label="PLG_FINDER_J2STORE_SELECT_MENU_ITEM_LABEL"
                    description="PLG_FINDER_J2STORE_SELECT_MENU_ITEM_LABEL_DESC"
                    showon="redirect_to:j2store"
                    >
                    <option value="">J2STORE_SELECT_OPTION</option>
                </field>

                <field
                    name="use_menu_title"
                    type="radio"
                    label="PLG_FINDER_J2STORE_USE_MENU_TITLE_LABEL"
                    description="PLG_FINDER_J2STORE_USE_MENU_TITLE_DESC"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_product_image"
                    type="radio"
                    label="PLG_FINDER_J2STORE_SHOW_PRODUCT_IMAGE_LABEL"
                    description="PLG_FINDER_J2STORE_SHOW_PRODUCT_IMAGE_DESC"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="exclude_linked_articles"
                    type="radio"
                    label="PLG_FINDER_J2STORE_EXCLUDE_LINKED_ARTICLES_LABEL"
                    description="PLG_FINDER_J2STORE_EXCLUDE_LINKED_ARTICLES_DESC"
                    default="0"
                    layout="joomla.form.field.radio.switcher"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
