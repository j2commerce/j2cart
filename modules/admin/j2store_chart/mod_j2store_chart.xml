<?xml version="1.0" encoding="utf-8"?>
<extension type="module" method="upgrade" client="administrator" position ="j2store-module-position-3">
	<name>J2 Store Chart</name>
	<creationDate>APR 2026</creationDate>
	<author>J2Commerce</author>
	<copyright>(C) 2014-2024 J2Store Weblogicx India</copyright>
	<copyright>(C) 2024-2026 J2Commerce, LLC</copyright>
	<authorEmail>support@j2commerce.com</authorEmail>
	<authorUrl>https://www.j2commerce.com</authorUrl>
	<license>GNU General Public License v3 or later versions</license>
	<version>4.0.0</version>
	<description>
	 <![CDATA[<p>J2 Store Chart
	 <p> Please contact to us for more info <a href="mailto:support@j2store.org">support@j2store.org</a></p>
	]]>

	</description>
<files>
	<filename module="mod_j2store_chart">mod_j2store_chart.php</filename>
	<filename>helper.php</filename>
	<filename>mod_j2store_chart.xml</filename>
	<folder>tmpl</folder>
	<folder>media</folder>
</files>
<config>
	<fields name="params">
		<fieldset name="basic" addfieldpath="administrator/components/com_j2store/models/fields">
			<field
				name="chart_type"
				type="list"
				default="1"
				label="MOD_J2STORE_CHART_TYPE"
				description="MOD_J2STORE_CHART_TYPE_DESC"
				>
				<option value="daily">MOD_J2STORE_CHART_DAILY</option>
				<option value="monthly">MOD_J2STORE_CHART_MONTHLY</option>
				<option value="yearly">MOD_J2STORE_CHART_YEARLY</option>
			</field>
			<field
				name="order_status"
				type="orderstatuslist"
				multiple="true"
				label="J2STORE_ORDER_STATUS"
			/>
		</fieldset>
	</fields>

</config>
</extension>
